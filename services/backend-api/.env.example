# Generate strong secrets for production via: openssl rand -base64 64
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# --- Social sign-in (Google / Apple) ------------------------------------
# Comma-separated OAuth client IDs we accept in an ID token's `aud` claim.
# A provider with no client IDs here is switched off: /auth/providers stops
# advertising it and the app hides its button.
#
# Google issues a separate client ID per platform and the ID token carries
# whichever one started the flow, so list all three (web, iOS, Android) —
# they must match EXPO_PUBLIC_GOOGLE_*_CLIENT_ID in the student app.
# GOOGLE_OAUTH_CLIENT_IDS=xxx.apps.googleusercontent.com,yyy.apps.googleusercontent.com
#
# Apple's `aud` is the app's bundle identifier for the native iOS flow.
# APPLE_OAUTH_CLIENT_IDS=com.gomaths.mathai
#
# Signs the short-lived ticket between /auth/oauth and /auth/oauth/complete.
# Falls back to JWT_ACCESS_SECRET when unset.
# OAUTH_SIGNUP_SECRET=

# AI services URLs (defaults match running locally with uvicorn).
TUTOR_SERVICE_URL=http://localhost:8001
SOLVER_SERVICE_URL=http://localhost:8002
VALIDATION_SERVICE_URL=http://localhost:8003

# Backend listens on PORT.
PORT=4000

# PostgreSQL connection string. When set, Prisma takes over the
# Conversation / User / Session / Progress / PushToken stores. When unset,
# services fall back to in-memory implementations.
# DATABASE_URL=postgresql://gomaths:devpass@localhost:5432/gomaths?schema=public

# Redis URL for the rate-limiter and scheduler leader election. When
# unset, throttling falls back to per-pod counters and the scheduler
# always runs (single-pod dev). Production must set this.
# REDIS_URL=redis://localhost:6379

# Sentry. Leave unset locally — `Sentry.init` is a no-op without DSN.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=1
# SENTRY_PROFILES_SAMPLE_RATE=1

# Optional override for filesystem curriculum source.
# CURRICULUM_ROOT=/absolute/path/to/curriculum-data
