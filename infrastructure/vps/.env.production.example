# Production env file for the VPS docker compose deployment.
#
# Copy to .env.production at the repo root and fill in every value:
#   cp infrastructure/vps/.env.production.example .env.production
#
# Then start the stack:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# .env.production is gitignored — never commit it.

# =============================================================================
# Domain + TLS
# =============================================================================
# Domain + TLS are configured in the shared Caddy project — see
# infrastructure/vps/caddy/Caddyfile and infrastructure/vps/caddy/.env.
# This file owns no public-facing config.

# =============================================================================
# Database (local postgres container)
# =============================================================================
POSTGRES_USER=gomaths
POSTGRES_DB=gomaths
# Generate: openssl rand -base64 32 | tr -d '/+=' | head -c 32
POSTGRES_PASSWORD=CHANGE_ME

# =============================================================================
# Redis (local redis container)
# =============================================================================
# Generate: openssl rand -base64 32 | tr -d '/+=' | head -c 32
REDIS_PASSWORD=CHANGE_ME

# =============================================================================
# Backend signing secrets
# =============================================================================
# Generate each: openssl rand -base64 64 | tr -d '\n'
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
PARENTAL_CONSENT_INVITE_SECRET=CHANGE_ME
PARENTAL_CONSENT_RECEIPT_SECRET=CHANGE_ME

# =============================================================================
# Email (Resend) — required for parental consent flow
# =============================================================================
# https://resend.com → API Keys
RESEND_API_KEY=re_...
# Domain part MUST be verified in Resend (DKIM + SPF records added).
EMAIL_FROM=GoMaths <consent@example.com>
# Base URL for the link mailed to parents in the consent flow. The
# confirmation page is rendered by THIS API (GET /api/auth/parental-consent/confirm),
# not a separate frontend, so this must be this API's own public origin —
# not a marketing site or web-app build, which won't have that route.
PUBLIC_APP_URL=https://api.example.com

# =============================================================================
# CORS — browser clients allowed to call this API
# =============================================================================
# Comma-separated list of origins (scheme + host, no trailing slash).
# Native iOS/Android builds do NOT need this; only browsers do.
# Leave blank in production and every browser call is blocked.
#
# A `*` matches one hostname label, which covers Cloudflare Pages preview
# deployments without opening up the whole of pages.dev:
#   CORS_ORIGINS=https://gomaths.co.za,https://*.gomaths-student.pages.dev
CORS_ORIGINS=

# =============================================================================
# Sentry (optional — leave blank to disable)
# =============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# =============================================================================
# Tutor service
# =============================================================================
# Leave TUTOR_PROVIDER unset to auto-detect by which key is present:
#   1. OPENAI_API_KEY    -> OpenAI provider
#   2. ANTHROPIC_API_KEY -> Anthropic provider
#   3. neither           -> mock provider (canned replies, no LLM cost)
# To force a specific provider, set TUTOR_PROVIDER=openai | anthropic | mock.
TUTOR_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override. Defaults: gpt-4o-mini (OpenAI), claude-haiku-4-5 (Anthropic).
TUTOR_MODEL=

# =============================================================================
# Solver OCR service
# =============================================================================
# Leave SOLVER_OCR_PROVIDER unset to auto-detect by which credentials
# are present, in quality order:
#   1. MATHPIX_APP_ID + MATHPIX_APP_KEY -> MathPix      (best for handwritten maths)
#   2. OPENAI_API_KEY                   -> OpenAI vision (gpt-4o-mini, cheap, good)
#   3. ANTHROPIC_API_KEY                -> Claude vision (claude-haiku-4-5)
#   4. none                             -> mock (canned LaTeX, no LLM cost)
# To force a specific provider, set
# SOLVER_OCR_PROVIDER=mathpix | openai | claude | mock.
SOLVER_OCR_PROVIDER=
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
# Optional model override for openai-vision / claude-vision.
# Defaults: gpt-4o-mini (OpenAI), claude-haiku-4-5 (Claude).
SOLVER_OCR_MODEL=
