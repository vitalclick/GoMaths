# Central reverse proxy for every app on this VPS.
#
# Each public hostname gets one block. The reverse_proxy target uses the
# app container's network alias on the shared `web` docker network — see
# each app's compose file for the alias it registers.
#
# Reload after editing:
#   docker compose -f infrastructure/vps/caddy/docker-compose.yml exec caddy \
#     caddy reload --config /etc/caddy/Caddyfile

{
	email {$ACME_EMAIL}
	# Uncomment while iterating on DNS / firewall to avoid Let's Encrypt
	# rate limits:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ─── GoMaths ────────────────────────────────────────────────────────────

# Public site: home, privacy notice, terms. Served straight off disk from
# the repo checkout (see the `site` volume in docker-compose.yml), so it
# stays up even when the API is down — and a `git pull` on the VPS is a
# deploy, with no container rebuild.
#
# Google's OAuth consent screen requires the privacy policy and terms URLs
# to be publicly reachable on the authorised domain, so this block is what
# makes social sign-in publishable.
gomaths.co.za {
	encode zstd gzip
	root * /srv/gomaths-site
	file_server
	# Serve /privacy and /terms as well as the .html paths.
	try_files {path} {path}.html {path}/index.html
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
	log {
		output stdout
		format console
	}
}

www.gomaths.co.za {
	redir https://gomaths.co.za{uri} permanent
}

api.gomaths.co.za {
	encode zstd gzip
	reverse_proxy gomaths-backend:8080 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
	@blocked {
		path /wp-* /xmlrpc.php /.env /.git/* /phpmyadmin*
	}
	respond @blocked 404
	log {
		output stdout
		format console
	}
}

# ─── Add new apps below ─────────────────────────────────────────────────
# Template:
#
# api.<your-app>.com {
#   encode zstd gzip
#   reverse_proxy <your-app>-backend:<port>
# }
#
# The alias <your-app>-backend must be registered by the app's compose
# file as a network alias on the shared `web` network:
#
#   services:
#     backend:
#       networks:
#         <your-app>-internal:
#         web:
#           aliases:
#             - <your-app>-backend
#   networks:
#     <your-app>-internal:
#     web:
#       external: true
